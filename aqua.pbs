#!/usr/bin/env bash
#PBS -N dnaprs_controller
#PBS -S /bin/bash
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=168:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
if [[ ! -f main.nf || ! -f nextflow.config ]]; then
    echo "Submit aqua.pbs from the dnaprs pipeline directory." >&2
    exit 2
fi

module purge
module load Java/21.0.8

nextflow_bin="${DNAPRS_NEXTFLOW:-$HOME/.local/share/dnaprs/nextflow-25.10.4-dist}"
params_file="${DNAPRS_PARAMS_FILE:-runs/current/params.yaml}"
work_dir="${DNAPRS_WORK_DIR:-work}"
output_dir="${DNAPRS_OUTPUT_DIR:-results}"
plugin_dir="${NXF_PLUGINS_DIR:-$HOME/.nextflow/plugins}"

if [[ ! -x "$nextflow_bin" ]]; then
    echo "Pinned Nextflow executable is not available: $nextflow_bin" >&2
    exit 3
fi
if [[ ! -f "$params_file" ]]; then
    echo "Parameter file is not available: $params_file" >&2
    exit 4
fi
if [[ -z "${DNAPRS_R_LIBS_USER:-}" || ! -d "$DNAPRS_R_LIBS_USER" ]]; then
    echo "DNAPRS_R_LIBS_USER must name the fixed Aquarius R 4.4.1 library." >&2
    exit 5
fi
if [[ ! -d "$plugin_dir/nf-schema-2.7.2" ]]; then
    echo "nf-schema 2.7.2 is not installed in $plugin_dir." >&2
    exit 6
fi
command -v qsub >/dev/null || { echo "qsub is unavailable." >&2; exit 7; }
command -v qstat >/dev/null || { echo "qstat is unavailable." >&2; exit 8; }

mkdir -p logs/prs "$work_dir" "$output_dir"
job_id="${PBS_JOBID:-manual}"
controller_log="logs/prs/dnaprs_${job_id}.log"
exec > >(tee -a "$controller_log") 2>&1

export NXF_PLUGINS_DIR="$plugin_dir"
export NXF_OFFLINE="${DNAPRS_OFFLINE:-true}"
export NXF_LOG_FILE="logs/prs/dnaprs_nextflow_${job_id}.log"

echo "dnaprs controller job: $job_id"
echo "Working directory: $PWD"
echo "Parameters: $params_file"
echo "Work directory: $work_dir"
echo "Output directory: $output_dir"
echo "R library: $DNAPRS_R_LIBS_USER"
echo "Nextflow: $nextflow_bin"
date --iso-8601=seconds

resume_option=()
if [[ "${DNAPRS_RESUME:-false}" == "true" ]]; then resume_option=(-resume); fi

"$nextflow_bin" run . \
    -profile aqua \
    -params-file "$params_file" \
    -work-dir "$work_dir" \
    --outdir "$output_dir" \
    "${resume_option[@]}"

date --iso-8601=seconds
echo "dnaprs completed successfully."
