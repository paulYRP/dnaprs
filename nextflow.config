/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    paulYRP/dnaprs Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    run_name                       = 'model1'
    outdir                         = 'dnaprs'
    input                          = 'data/plink/raw'
    gwas                           = 'data/gwas/raw'
    references                     = null
    reference_mode                 = 'auto'
    reference_dir                  = 'references/dnaprs'
    reference_bundle               = 'grch37-v1'
    reference_only                 = false
    beagle_jar                     = null
    unbref3_jar                    = null
    phenotype                      = null
    outcome                        = null
    covariates                     = null
    model_type                     = null
    participant_id                 = null
    timepoint_column               = null
    timepoint_values               = null
    group_column                   = null
    control_value                  = null
    case_value                     = null
    models                         = null
    model_id                       = null
    methods                        = 'plink_ct,sbayesrc'
    genome                         = 'GRCh37'
    seed                           = 20260829
    report_enabled                 = true
    sample_missingness             = 0.02
    imputation_variant_missingness = 0.10
    direct_variant_missingness     = 0.01
    maf_filter                     = 0.0
    hwe_filter                     = 0.0
    ancestry_pcs                   = 10
    ancestry_percentile            = 0.99
    target_imputation              = true
    imputation_dr2                 = 0.80
    stop_after                     = 'report'

    publish_dir_mode = 'copy'
    overwrite        = false
    email            = null
    email_on_fail    = null
    plaintext_email  = false
    monochrome_logs  = false
    help             = false
    help_full        = false
    show_hidden      = false
    version          = false
    validate_params  = true

    config_profile_name        = null
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode
// The driver rejects a non-empty run directory unless this is a resume or
// replacement is explicitly enabled. Recomputed outputs must replace stale files.
workflow.output.overwrite = true

includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes = true
        cleanup = false
        nextflow.enable.configProcessNamesValidation = true
    }

    standard {
        process.executor = 'local'
    }

    pbspro {
        process.executor = 'pbspro'
    }

    slurm {
        process.executor = 'slurm'
    }

    sge {
        process.executor = 'sge'
    }

    lsf {
        process.executor = 'lsf'
    }

    docker {
        includeConfig 'conf/docker.config'
    }

    apptainer {
        includeConfig 'conf/apptainer.config'
    }

    singularity {
        includeConfig 'conf/singularity.config'
    }

    test {
        includeConfig 'conf/test.config'
    }

    test_full {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_full.config'
    }

    stub {
        includeConfig 'conf/stub.config'
    }
}

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

apptainer.registry   = 'quay.io'
singularity.registry = 'quay.io'

env {
    PYTHONNOUSERSITE = '1'
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
    LC_ALL           = 'C'
    LANG             = 'C'
}

process.shell = [
    'bash',
    '-C',
    '-e',
    '-u',
    '-o',
    'pipefail',
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/${params.run_name}/reports/provenance/execution_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/${params.run_name}/reports/provenance/execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/${params.run_name}/reports/provenance/execution_trace.txt"
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,attempt,workdir,container,module'
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/${params.run_name}/reports/provenance/pipeline_dag.html"
}

manifest {
    name = 'paulYRP/dnaprs'
    contributors = [
        [
            name: 'Paul Ruiz Pinto',
            affiliation: 'Queensland University of Technology',
            email: '',
            github: 'paulYRP',
            contribution: ['author', 'maintainer'],
            orcid: '',
        ],
    ]
    homePage = 'https://github.com/paulYRP/dnaprs'
    description = 'Generate and evaluate polygenic risk scores with PLINK and SBayesRC.'
    mainScript = 'main.nf'
    defaultBranch = 'dev'
    nextflowVersion = '!>=25.10.4'
    version = '1.0.0dev'
    doi = ''
}

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    // nf-schema documents these nested records for forms/help, while the
    // stage-aware R resolver performs their complete cross-field validation.
    ignoreParams = ['input', 'gwas', 'references', 'models']
    monochromeLogs = params.monochrome_logs
}

includeConfig 'conf/modules.config'
