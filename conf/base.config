process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h

    // Keep retry escalation within the largest documented single-node allocation.
    // Site launchers may override this standard Nextflow directive when needed.
    resourceLimits = [cpus: 32, memory: 256.GB, time: 7.d]

    errorStrategy = { task.exitStatus in [137, 143, 247] ? 'retry' : 'terminate' }
    maxRetries    = 1

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 16 * task.attempt }
        memory = { 96.GB * task.attempt }
        time   = { 36.h * task.attempt }
    }

    withLabel: process_high_memory {
        memory = { 256.GB * task.attempt }
    }

    withLabel: process_long {
        time = { 3.d * task.attempt }
    }

    withLabel: process_sbayesrc {
        cpus   = { 32 * task.attempt }
        memory = { 256.GB * task.attempt }
        time   = { 4.d * task.attempt }
    }

    withLabel: process_report {
        cpus   = 2
        memory = 16.GB
        time   = 4.h
    }
}
