params {
    run_name         = 'test'
    input            = "${projectDir}/tests/data/target"
    gwas             = "${projectDir}/tests/data/gwas"
    references       = "${projectDir}/tests/data/reference"
    reference_mode   = 'local'
    phenotype        = "${projectDir}/tests/data/phenotype.tsv"
    outcome          = 'MHC_TOTAL'
    covariates       = 'Age,Sex'
    model_type       = 'gaussian'
    participant_id   = 'IID'
    methods          = 'plink_ct'
    genome           = 'GRCh37'
    seed             = 20260829
    report_enabled   = true
    target_imputation = true
}

process {
    stageInMode = 'copy'
    cpus   = 1
    memory = 2.GB
    time   = 10.m

    withLabel: 'process_low|process_medium|process_high|process_sbayesrc|process_report' {
        cpus     = 1
        memory   = 2.GB
        time     = 10.m
        maxForks = 2
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false

env {
    LC_ALL = 'C'
    LANG   = 'C'
}
