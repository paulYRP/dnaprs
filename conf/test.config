params {
    run_name = 'test'
    input = [[
        id: 'TEST',
        path: "${projectDir}/tests/data/target/test_target.vcf",
        format: 'vcf',
        stage: 'raw',
        build: 'GRCh37',
        ancestry: 'European',
    ]]
    gwas = [[
        id: 'MDD',
        path: "${projectDir}/tests/data/gwas/mdd.tsv",
        build: 'GRCh37',
        ancestry: 'European',
        effect_type: 'log_or',
        sample_size: 100000,
        prs_name: 'MDD_PRS',
        columns: [
            variant: 'SNP', chromosome: 'CHR', position: 'BP',
            effect_allele: 'A1', other_allele: 'A2', effect: 'BETA',
            standard_error: 'SE', p_value: 'P', frequency: 'EAF', sample_size: 'N',
        ],
    ]]
    references = [
        root: "${projectDir}/tests/data/reference",
        assets: [
            dbsnp: 'dbsnp_source',
            fasta: 'human_g1k_v37.fasta',
            fasta_index: 'human_g1k_v37.fasta.fai',
            imputation_panel: 'source_panel',
            population_metadata: 'population.tsv',
            related_samples: 'related.txt',
            unbref3_jar: 'unbref3.test.jar',
        ],
    ]
    reference_mode = 'local'
    phenotype = "${projectDir}/tests/data/phenotype.tsv"
    outcome = 'MHC_TOTAL'
    covariates = 'Age,Sex'
    model_type = 'gaussian'
    participant_id = 'IID'
    methods = 'plink_ct'
    genome = 'GRCh37'
    seed = 20260829
    report_enabled = true
    ancestry_pcs = 2
    target_imputation = false
}

process {
    stageInMode = 'copy'
    cpus   = 1
    memory = 2.GB
    time   = 10.m

    withLabel: 'process_single|process_low|process_medium|process_high' {
        cpus     = 1
        memory   = 2.GB
        time     = 10.m
        maxForks = 2
    }
}

env {
    LC_ALL = 'C'
    LANG   = 'C'
}
