// Resource caps for wiring checks that use the caller's own manifests. Unlike the
// synthetic test profile, this profile does not replace params or copy large inputs.
process {
    executor = 'local'
    cpus     = 1
    memory   = 2.GB
    time     = 10.m

    withLabel: 'process_single|process_low|process_medium|process_high' {
        cpus     = 1
        memory   = 2.GB
        time     = 10.m
        maxForks = 2
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false
