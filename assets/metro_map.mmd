%%metro style: dark
%%metro file: target_in | TARGET
%%metro file: gwas_in | GWAS
%%metro file: reference_in | REF
%%metro file: phenotype_in | PHENO
%%metro file: report_out | HTML
%%metro line: shared | Target preparation & QC | #0570B0
%%metro line: references | Reference acquisition & verification | #2DB572
%%metro line: plink_ct | PLINK C+T primary | #F5C542
%%metro line: plink_direct | PLINK direct sensitivity | #FF8C00
%%metro line: phenotype | Phenotype models | #E63946
%%metro line: sbayesrc | SBayesRC | #7B2D3B
%%metro legend: bl

graph LR
    subgraph inputs [Raw inputs and validation]
        %%metro exit: right | shared,references,plink_ct,sbayesrc
        target_in[ ]
        target_discover[Discover]
        target_validate[Validate]
        gwas_in[ ]
        gwas_columns[Columns]
        gwas_validate[Validate]
        reference_in[ ]
        reference_resolve[Local / auto]
        reference_verify[SHA-256]

        target_in -->|shared| target_discover
        target_discover -->|shared| target_validate
        gwas_in -->|plink_ct,sbayesrc| gwas_columns
        gwas_columns -->|plink_ct,sbayesrc| gwas_validate
        reference_in -->|references| reference_resolve
        reference_resolve -->|references| reference_verify
    end

    subgraph preparation [Target and GWAS preparation]
        %%metro entry: left | shared,references,plink_ct,sbayesrc
        %%metro exit: right | shared,references,plink_ct,sbayesrc
        raw_eda[Raw EDA]
        target_prep[Markers]
        target_qc[QC checks]
        ancestry[PCA]
        eligible[Eligible]
        target_impute[Beagle]
        imputation_merge[Post-QC]
        score_target[Target]
        gwas_qc[GWAS ready]
        reference_bundle[Bundle]
        reference_pca[PCA / LD]
        reference_beagle[Beagle]
        reference_sbayes[SBayesRC]
        references_ready[Ready]

        target_validate -->|shared| raw_eda
        raw_eda -->|shared| target_prep
        target_prep -->|shared| target_qc
        target_qc -->|shared| ancestry
        ancestry -->|shared| eligible
        eligible -->|shared| score_target
        target_qc -->|shared| target_impute
        target_impute -->|shared| imputation_merge
        imputation_merge -->|shared| score_target

        gwas_validate -->|plink_ct,sbayesrc| gwas_qc

        reference_verify -->|references| reference_bundle
        reference_bundle -->|references| reference_pca
        reference_pca -->|references| reference_beagle
        reference_beagle -->|references| reference_sbayes
        reference_sbayes -->|references| references_ready
    end

    subgraph scoring [PRS generation]
        %%metro entry: left | shared,references,plink_ct,plink_direct,sbayesrc
        %%metro exit: bottom | plink_ct,plink_direct,sbayesrc
        reference_freq[LD frequency]
        align[Align]
        clump[Clump]
        ct_weights[Weights]
        direct_score[Direct]
        plink_score[Score]
        sensitivity[Agreement]
        tidy[Tidy]
        impute[Summary imputation]
        model[Joint model]
        sbayes_score[Participant score]
        sbayes_audit[Audit]

        references_ready -->|plink_ct| reference_freq
        reference_freq -->|plink_ct| align
        gwas_qc -->|plink_ct| align
        align -->|plink_ct| clump
        clump -->|plink_ct| ct_weights
        ct_weights -->|plink_direct| direct_score
        target_qc -->|plink_direct| direct_score
        direct_score -->|plink_direct| sensitivity

        ct_weights -->|plink_ct| plink_score
        score_target -->|plink_ct| plink_score
        plink_score -->|plink_ct| sensitivity

        gwas_qc -->|sbayesrc| tidy
        references_ready -->|sbayesrc| tidy
        tidy -->|sbayesrc| impute
        impute -->|sbayesrc| model
        references_ready -->|sbayesrc| model
        model -->|sbayesrc| sbayes_score
        score_target -->|sbayesrc| sbayes_score
        sbayes_score -->|sbayesrc| sbayes_audit
    end

    subgraph associations [Score integration and phenotype models]
        %%metro entry: top | plink_ct,plink_direct,sbayesrc
        %%metro exit: right | shared,phenotype
        phenotype_in[ ]
        combine[Combine scores]
        join[Join]
        fit[Fit models]
        diagnostics[Diagnostics]

        sensitivity -->|plink_ct,plink_direct| combine
        sbayes_audit -->|sbayesrc| combine
        phenotype_in -->|phenotype| join
        combine -->|phenotype| join
        join -->|phenotype| fit
        fit -->|phenotype| diagnostics
    end

    subgraph reporting [Quality control, outputs and reporting]
        generation_qc[Generation QC]
        versions[Versions]
        build_report[Build website]
        report_out[ ]

        combine -->|shared| generation_qc
        diagnostics -->|phenotype| generation_qc
        generation_qc -->|shared| versions
        versions -->|shared| build_report
        build_report -->|shared| report_out
    end
