%%metro title: dnaprs
%%metro logo: ../docs/images/nf-core-dnaprs_logo_light.png
%%metro style: light
%%metro line: shared | Target and shared processing | #0570b0
%%metro line: references | Reference resources | #2db572
%%metro line: plink_ct | PLINK C+T | #f5c542
%%metro line: plink_direct | Direct-score sensitivity | #ff8c00
%%metro line: phenotype | Phenotype association (optional) | #e63946
%%metro line: sbayesrc | SBayesRC | #7b2d3b
%%metro file: target_in | TARGET
%%metro file: gwas_in | GWAS
%%metro file: reference_in | REF
%%metro file: reference_out | CACHE
%%metro file: dbsnp_in | REF | dbSNP
%%metro file: ancestry_in | REF | PCA
%%metro file: beagle_in | REF | Beagle
%%metro file: plink_ref | REF | LD / frequency
%%metro file: sbayes_ref | REF | LD / annotation
%%metro file: phenotype_in | PHENO
%%metro file: scores_out | CSV
%%metro file: report_out | HTML
%%metro legend: bl
%%metro diamond_style: symmetric
%%metro grid: inputs | 0,0
%%metro grid: preparation | 1,0
%%metro grid: scoring | 2,0
%%metro grid: associations | 2,1
%%metro grid: reporting | 1,1
%%metro section_x_gap: 65
%%metro section_y_gap: 85
%%metro x_spacing: 70
%%metro y_spacing: 60
%%metro row_align: top
%%metro compact_offsets: true
%%metro off_track: dbsnp_in, ancestry_in, beagle_in, plink_ref, sbayes_ref

graph LR
    subgraph inputs [Inputs and validation]
        target_in[ ]
        target_validate[Validate]
        raw_eda[Raw EDA]
        gwas_in[ ]
        gwas_validate[Columns]
        reference_in[ ]
        reference_resolve[Local / auto]
        reference_verify[Verify]
        reference_out[ ]

        target_in -->|shared| target_validate
        target_validate -->|shared| raw_eda
        gwas_in -->|plink_ct,sbayesrc| gwas_validate
        reference_in -->|references| reference_resolve
        reference_resolve -->|references| reference_verify
        reference_verify -->|references| reference_out
    end

    subgraph preparation [Target and GWAS preparation]
        target_prep[Markers]
        target_qc[Target QC]
        ancestry[Ancestry PCA]
        eligible[Eligibility]
        target_impute[Beagle]
        imputation_qc[Imputation QC]
        score_target[Scoring target]
        gwas_harmonise[Harmonise]
        gwas_qc[GWAS QC]
        dbsnp_in[ ]
        ancestry_in[ ]
        beagle_in[ ]

        target_prep -->|shared| target_qc
        target_qc -->|shared| ancestry
        ancestry -->|shared| eligible
        eligible -->|shared| score_target
        target_qc -->|shared| target_impute
        target_impute -->|shared| imputation_qc
        imputation_qc -->|shared| score_target
        gwas_harmonise -->|plink_ct,sbayesrc| gwas_qc
        dbsnp_in -->|references| target_prep
        ancestry_in -->|references| ancestry
        beagle_in -->|references| target_impute
    end

    subgraph scoring [PRS generation]
        %%metro exit: bottom | shared
        plink_ref[ ]
        sbayes_ref[ ]
        align[Align]
        clump[Clump]
        ct_weights[Weights]
        plink_score[PLINK score]
        direct_score[Direct score]
        tidy[Tidy]
        impute[Summary impute]
        model[Joint model]
        sbayes_score[SBayesRC score]
        combine[Combine scores]

        align -->|plink_ct| clump
        plink_ref -->|references| align
        clump -->|plink_ct| ct_weights
        ct_weights -->|plink_ct| plink_score
        ct_weights -->|plink_direct| direct_score
        plink_score -->|plink_ct| combine
        tidy -->|sbayesrc| impute
        sbayes_ref -->|references| tidy
        impute -->|sbayesrc| model
        model -->|sbayesrc| sbayes_score
        sbayes_score -->|sbayesrc| combine
    end

    subgraph associations [Scores and phenotype]
        %%metro direction: RL
        %%metro entry: right | shared
        scores[PRS tables]
        phenotype_in[ ]
        join[Join scores]
        fit[Fit models]
        diagnostics[Diagnostics]
        _scores_join[hidden]
        _scores_fit[hidden]
        _scores_diagnostics[hidden]

        phenotype_in -->|phenotype| join
        scores -->|phenotype| join
        join -->|phenotype| fit
        fit -->|phenotype| diagnostics
        scores -->|shared| _scores_join
        _scores_join -->|shared| _scores_fit
        _scores_fit -->|shared| _scores_diagnostics
    end

    subgraph reporting [Results and reporting]
        %%metro direction: RL
        generation_qc[Score QC]
        scores_out[ ]
        build_report[Report]
        report_out[ ]

        generation_qc -->|shared| build_report
        generation_qc -->|shared| scores_out
        build_report -->|shared,phenotype| report_out
    end

    %% Raw EDA describes the input; it does not feed target preparation.
    target_validate -->|shared| target_prep
    gwas_validate -->|plink_ct,sbayesrc| gwas_harmonise
    %% REF icons identify independent consumers of the verified reference cache.
    gwas_qc -->|plink_ct| align
    gwas_qc -->|sbayesrc| tidy
    score_target -->|shared| align
    score_target -->|shared| plink_score
    score_target -->|shared| sbayes_score
    eligible -->|plink_direct| direct_score

    %% Only primary scores enter the combined score table and phenotype models.
    combine -->|shared| scores
    %% Routing anchors keep the phenotype-independent output path straight.
    _scores_diagnostics -->|shared| generation_qc
    diagnostics -->|phenotype| build_report
