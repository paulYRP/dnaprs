nextflow_process {

    name "Test Process PHENOTYPE_ASSOCIATION with real software"
    script "../main.nf"
    process "PHENOTYPE_ASSOCIATION"
    tag "modules"
    tag "modules_local"
    tag "modules_real"
    tag "phenotype_association"

    test("binomial phenotype association - real") {

        when {
            process {
                """
                input[0] = [[cohort: 'TEST', role: 'target', trait_id: 'MDD', prs_name: 'MDD_PRS', method: 'plink_ct'], file("${projectDir}/tests/data/scores/test_binomial.score.tsv"), file("${projectDir}/tests/data/phenotype_models_binomial.tsv"), 'depression']
                input[1] = file("${projectDir}/tests/data/phenotype_binomial.tsv")
                input[2] = file("${projectDir}/bin/phenotype_association.R")
                input[3] = 20260829
                """
            }
        }

        then {
            def result = file(process.out.associations[0]).text
            def fields = result.readLines()[1].replace('"', '').split('\t', -1)
            assert process.success
            assert fields[6] == 'binomial'
            assert fields[7] == '6'
            assert Double.isFinite(fields[8] as Double)
            assert fields[25] == 'PASS'
            assert fields[27] == 'PASS'
            assert fields[29] in ['ESTIMATED', 'REVIEW_DIAGNOSTICS']
            assert file(process.out.fitted_models[0]).text.contains('glm2::glm2')
        }
    }
}
