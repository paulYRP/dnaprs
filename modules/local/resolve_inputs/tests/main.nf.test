nextflow_process {

    name "Test Process RESOLVE_INPUTS"
    script "../main.nf"
    process "RESOLVE_INPUTS"
    tag "modules"
    tag "modules_local"
    tag "modules_stub"
    tag "resolve_inputs"

    test("input resolver - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = 'IiI='
                input[1] = 'IiI='
                input[2] = 'IiI='
                input[3] = 'W10='
                input[4] = 'GRCh37'
                input[5] = ['plink_ct']
                input[6] = false
                input[7] = 'target_qc'
                input[8] = false
                input[9] = 'auto'
                input[10] = 'grch37-v1'
                input[11] = ''
                input[12] = ''
                input[13] = ''
                input[14] = ''
                input[15] = ''
                input[16] = ''
                input[17] = 'W10='
                input[18] = ''
                input[19] = ''
                input[20] = ''
                input[21] = ''
                input[22] = ''
                input[23] = file("${projectDir}/assets/empty_input")
                input[24] = file("${projectDir}/assets/empty_input")
                input[25] = file("${projectDir}/assets/empty_input")
                input[26] = file("${projectDir}/bin/resolve_inputs.R")
                """
            }
        }

        then {
            assert process.success
            assert process.out.targets.size() == 1
            assert process.out.gwas.size() == 1
            assert process.out.references.size() == 1
            assert process.out.models.size() == 1
            assert process.out.run_plan.size() == 1
            assert process.out.settings.size() == 1
            assert process.out.checks.size() == 1
            assert process.out.versions_r[0][2].toString()
            assert process.out.versions_jsonlite[0][2].toString()
            assert process.out.versions_openssl[0][2].toString()
            assert process.out.versions_yaml[0][2].toString()
        }
    }
}
