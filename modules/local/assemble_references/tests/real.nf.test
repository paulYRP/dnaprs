nextflow_process {

    name "Assemble local and downloaded references with staged paths"
    script "../main.nf"
    process "ASSEMBLE_REFERENCES"
    tag "modules"
    tag "modules_local"
    tag "modules_real"
    tag "assemble_references"

    test("relative local FASTA and companion are combined with a downloaded asset") {
        when {
            process {
                """
                source_files = [
                    file("${projectDir}/tests/data/reference/human_g1k_v37.fasta"),
                    file("${projectDir}/tests/data/reference/human_g1k_v37.fasta.fai")
                ]
                input[0] = [[
                    asset_id: 'annotation_source.zip', reference_type: 'annotation_source',
                    relative_path: 'annotation/source.zip', reference_path: 'annotation/source.zip',
                    companion: '', source_format: 'zip', ancestry: 'European', version: 'test',
                    url: 'https://example.invalid/fixture', checksum_algorithm: 'sha256',
                    checksum: 'fixture', size: '1'
                ]]
                input[1] = [file("${projectDir}/tests/data/reference/annotation_source.zip")]
                input[2] = file("${projectDir}/tests/data/reference_assembly.tsv")
                input[3] = tuple(source_files.collect { it.toString() }, source_files)
                input[4] = '${projectDir}'
                input[5] = 'test'
                input[6] = 'GRCh37'
                input[7] = '/reference-cache/test'
                input[8] = file("${projectDir}/bin/assemble_references.R")
                """
            }
        }
        then {
            assert process.success
            def records = path(process.out.references[0]).text.readLines()
            def fasta = records.find { it.contains('\treference_fasta\t') }.split('\t', -1)
            assert fasta[4] == "${projectDir}/tests/data/reference/human_g1k_v37.fasta"
            assert fasta[5] == "${projectDir}/tests/data/reference/human_g1k_v37.fasta.fai"
            assert records.size() == 3
            assert path(process.out.bundle[0]).resolve('annotation/source.zip').exists()
            assert path(process.out.receipt[0]).text.contains('AUTHENTICATED')
        }
    }
}
