{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/dnaprs/main/nextflow_schema.json",
    "title": "nf-core/dnaprs pipeline parameters",
    "description": "Generate and evaluate polygenic risk scores with PLINK and SBayesRC.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input and output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define the quality-controlled inputs and the result directory.",
            "required": ["input", "gwas_manifest", "reference_manifest", "outdir"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "description": "TSV manifest describing quality-controlled target genotype cohorts.",
                    "help_text": "Each row declares one target cohort, its genotype format and paths, and the participant keep file. Source genotype files are read-only.",
                    "fa_icon": "fas fa-dna"
                },
                "gwas_manifest": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "description": "TSV manifest describing quality-controlled GWAS summary statistics.",
                    "help_text": "Each row declares one trait and the exact source columns for chromosome, position, alleles, effect, uncertainty, P value, sample size, and allele frequency where required.",
                    "fa_icon": "fas fa-table"
                },
                "reference_manifest": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "description": "TSV manifest describing the independent LD and annotation resources.",
                    "help_text": "The declared resources must use the same genome build and compatible variant identifiers as the target and GWAS inputs.",
                    "fa_icon": "fas fa-book"
                },
                "manifest_base": {
                    "type": ["string", "null"],
                    "format": "directory-path",
                    "exists": true,
                    "description": "Base directory for relative paths inside manifests.",
                    "help_text": "When omitted, relative paths are resolved from the directory where Nextflow was launched.",
                    "fa_icon": "fas fa-folder-tree"
                },
                "phenotype_file": {
                    "type": ["string", "null"],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional phenotype table for prespecified PRS association models.",
                    "fa_icon": "fas fa-user-group"
                },
                "phenotype_models": {
                    "type": ["string", "null"],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional TSV declaring phenotype association models.",
                    "fa_icon": "fas fa-chart-line"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "results",
                    "description": "Directory where run-specific results and reports are saved.",
                    "fa_icon": "fas fa-folder-open"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for the completion summary.",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$",
                    "fa_icon": "fas fa-envelope"
                }
            }
        },
        "analysis_options": {
            "title": "PRS analysis options",
            "type": "object",
            "fa_icon": "fas fa-chart-column",
            "description": "Select the scoring methods and fixed run settings.",
            "properties": {
                "run_name": {
                    "type": "string",
                    "default": "dnaprs_run",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                    "description": "Stable name for the run-specific result folder.",
                    "fa_icon": "fas fa-tag"
                },
                "methods": {
                    "type": "string",
                    "enum": ["plink_ct", "sbayesrc", "plink_ct,sbayesrc"],
                    "default": "plink_ct,sbayesrc",
                    "description": "PRS methods to run.",
                    "help_text": "PLINK C+T and SBayesRC are independent branches that share harmonised GWAS and prepared target inputs.",
                    "fa_icon": "fas fa-code-branch"
                },
                "genome_build": {
                    "type": "string",
                    "enum": ["GRCh37", "GRCh38"],
                    "default": "GRCh37",
                    "description": "Genome build shared by the target, GWAS, and reference resources.",
                    "fa_icon": "fas fa-dna"
                },
                "seed": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 20260829,
                    "description": "Seed used by stochastic model steps.",
                    "fa_icon": "fas fa-dice"
                },
                "report_enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Render the portable dnaprs scientific report.",
                    "fa_icon": "fas fa-file-lines"
                }
            }
        },
        "institutional_config_options": {
            "title": "Institutional configuration options",
            "type": "object",
            "fa_icon": "fas fa-university",
            "description": "Parameters used to describe centralised compute profiles.",
            "properties": {
                "custom_config_version": {
                    "type": "string",
                    "default": "master",
                    "description": "Git revision for nf-core institutional configurations.",
                    "hidden": true
                },
                "custom_config_base": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "description": "Base URL or local directory for nf-core institutional configurations.",
                    "hidden": true
                },
                "config_profile_name": {
                    "type": ["string", "null"],
                    "description": "Institutional configuration name.",
                    "hidden": true
                },
                "config_profile_description": {
                    "type": ["string", "null"],
                    "description": "Institutional configuration description.",
                    "hidden": true
                },
                "config_profile_contact": {
                    "type": ["string", "null"],
                    "description": "Institutional configuration contact.",
                    "hidden": true
                },
                "config_profile_url": {
                    "type": ["string", "null"],
                    "description": "Institutional configuration documentation URL.",
                    "hidden": true
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-gears",
            "description": "Common nf-core execution options.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display the pipeline version and exit.",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "description": "Method used by Nextflow to save final workflow outputs.",
                    "hidden": true
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for a completion summary only when the pipeline fails.",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$",
                    "hidden": true
                },
                "plaintext_email": {
                    "type": "boolean",
                    "description": "Send a plain-text completion email instead of HTML.",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Disable coloured terminal output.",
                    "hidden": true
                },
                "validate_params": {
                    "type": "boolean",
                    "default": true,
                    "description": "Validate parameters against the pipeline schema.",
                    "hidden": true
                },
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message."
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full help message."
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message."
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/analysis_options" },
        { "$ref": "#/$defs/institutional_config_options" },
        { "$ref": "#/$defs/generic_options" }
    ]
}
