{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/paulYRP/dnaprs/main/nextflow_schema.json",
    "title": "paulYRP/dnaprs pipeline parameters",
    "description": "Generate and evaluate polygenic risk scores with PLINK and SBayesRC.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input and output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "required": ["input", "gwas", "outdir"],
            "properties": {
                "input": {
                    "type": ["string", "array"],
                    "mimetype": "application/octet-stream",
                    "default": "data/plink/raw",
                    "description": "Raw target-genotype directory or YAML list of explicit target records.",
                    "oneOf": [
                        { "type": "string", "format": "directory-path" },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["id", "path", "format"],
                                "properties": {
                                    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                                    "path": { "type": "string", "format": "path" },
                                    "format": {
                                        "type": "string",
                                        "enum": ["pgen", "bed", "ped", "bgen", "vcf", "genomestudio"]
                                    },
                                    "stage": {
                                        "type": "string",
                                        "enum": ["raw", "corrected", "qc_completed", "imputed"],
                                        "default": "raw"
                                    },
                                    "build": { "type": "string", "enum": ["GRCh37"], "default": "GRCh37" },
                                    "role": { "type": "string", "enum": ["target", "validation"], "default": "target" },
                                    "ancestry": { "type": "string", "default": "unspecified" },
                                    "sample": { "type": ["string", "null"], "format": "path" },
                                    "keep": { "type": ["string", "null"], "format": "path" },
                                    "dosage": { "type": ["string", "null"] },
                                    "assay_manifest": { "type": ["string", "null"], "format": "path" },
                                    "marker_map": { "type": ["string", "null"], "format": "path" }
                                }
                            }
                        }
                    ]
                },
                "gwas": {
                    "type": ["string", "array"],
                    "default": "data/gwas/raw",
                    "description": "Raw GWAS directory or YAML list of explicit GWAS records.",
                    "oneOf": [
                        { "type": "string", "format": "directory-path" },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["id", "path", "effect_type", "sample_size", "columns"],
                                "properties": {
                                    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                                    "path": { "type": "string", "format": "file-path", "exists": true },
                                    "build": { "type": "string", "enum": ["GRCh37"], "default": "GRCh37" },
                                    "ancestry": { "type": "string", "default": "unspecified" },
                                    "effect_type": { "type": "string", "enum": ["beta", "log_or", "or"] },
                                    "sample_size": { "type": "number", "exclusiveMinimum": 0 },
                                    "prs_name": { "type": ["string", "null"] },
                                    "source_format": { "type": "string", "default": "auto" },
                                    "columns": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "variant",
                                            "chromosome",
                                            "position",
                                            "effect_allele",
                                            "other_allele",
                                            "effect",
                                            "standard_error",
                                            "p_value"
                                        ],
                                        "properties": {
                                            "variant": { "type": "string" },
                                            "chromosome": { "type": "string" },
                                            "position": { "type": "string" },
                                            "effect_allele": { "type": "string" },
                                            "other_allele": { "type": "string" },
                                            "effect": { "type": "string" },
                                            "standard_error": { "type": "string" },
                                            "p_value": { "type": "string" },
                                            "frequency": { "type": ["string", "null"] },
                                            "case_frequency": { "type": ["string", "null"] },
                                            "control_frequency": { "type": ["string", "null"] },
                                            "case_n": { "type": ["string", "null"] },
                                            "control_n": { "type": ["string", "null"] },
                                            "sample_size": { "type": ["string", "null"] },
                                            "info": { "type": ["string", "null"] }
                                        }
                                    },
                                    "maf_min": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0.01 },
                                    "info_min": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
                                }
                            }
                        }
                    ]
                },
                "phenotype": {
                    "type": ["string", "null"],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional participant-level phenotype CSV."
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "dnaprs",
                    "description": "Result directory."
                },
                "run_name": {
                    "type": "string",
                    "default": "model1",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                    "description": "Run-specific result folder."
                },
                "overwrite": {
                    "type": "boolean",
                    "default": false,
                    "description": "Allow a non-resume run to replace files in an existing non-empty run folder. Existing directories are never deleted automatically.",
                    "fa_icon": "fas fa-triangle-exclamation"
                }
            }
        },
        "phenotype_options": {
            "title": "Phenotype model options",
            "type": "object",
            "description": "Declare one model on the command line or several models in params.yml.",
            "properties": {
                "outcome": { "type": ["string", "null"], "description": "Outcome column in the phenotype CSV." },
                "covariates": {
                    "type": ["string", "null"],
                    "description": "Comma-separated phenotype covariate columns, or none."
                },
                "model_type": {
                    "type": ["string", "null"],
                    "enum": ["gaussian", "binomial", "mixed", null],
                    "description": "Statistical model family for the declared outcome."
                },
                "participant_id": {
                    "type": ["string", "null"],
                    "description": "Participant-ID column; inferred only when one column matches target IDs unambiguously."
                },
                "timepoint_column": {
                    "type": ["string", "null"],
                    "description": "Phenotype column containing visit or timepoint values. Required with timepoint_values."
                },
                "timepoint_values": {
                    "type": ["array", "null"],
                    "description": "Visit or timepoint values retained for phenotype models. Fixed models require one value; mixed models may use several.",
                    "items": { "type": ["string", "number"] },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "group_column": {
                    "type": ["string", "null"],
                    "description": "Grouping column required by a mixed model."
                },
                "control_value": {
                    "type": ["string", "number", "boolean", "null"],
                    "description": "Phenotype value treated as the control level in a binomial model."
                },
                "case_value": {
                    "type": ["string", "number", "boolean", "null"],
                    "description": "Phenotype value treated as the case level in a binomial model."
                },
                "models": {
                    "type": "array",
                    "description": "One or more phenotype model records supplied in params.yml.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "outcome", "model_type"],
                        "properties": {
                            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                            "outcome": { "type": "string" },
                            "covariates": {
                                "type": ["string", "array"],
                                "oneOf": [
                                    { "type": "string" },
                                    { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                                ],
                                "default": "none"
                            },
                            "model_type": { "type": "string", "enum": ["gaussian", "binomial", "mixed"] },
                            "participant_id": { "type": ["string", "null"] },
                            "group_column": { "type": ["string", "null"] },
                            "control_value": { "type": ["string", "number", "boolean", "null"] },
                            "case_value": { "type": ["string", "number", "boolean", "null"] },
                            "score_ids": {
                                "type": ["string", "array"],
                                "oneOf": [
                                    { "const": "all" },
                                    {
                                        "type": "array",
                                        "items": { "type": "string" },
                                        "minItems": 1,
                                        "uniqueItems": true
                                    }
                                ],
                                "default": "all"
                            },
                            "expected_direction": {
                                "type": ["string", "null"],
                                "enum": ["positive", "negative", null]
                            },
                            "primary": { "type": "boolean", "default": true }
                        }
                    }
                },
                "model_id": { "type": ["string", "null"], "description": "Run one selected model from models." }
            },
            "allOf": [
                {
                    "if": {
                        "required": ["timepoint_values"],
                        "properties": { "timepoint_values": { "type": "array" } }
                    },
                    "then": {
                        "required": ["timepoint_column"],
                        "properties": { "timepoint_column": { "type": "string", "minLength": 1 } }
                    }
                },
                {
                    "if": {
                        "required": ["timepoint_column"],
                        "properties": { "timepoint_column": { "type": "string" } }
                    },
                    "then": {
                        "required": ["timepoint_values"],
                        "properties": { "timepoint_values": { "type": "array" } }
                    }
                }
            ]
        },
        "reference_options": {
            "title": "Reference options",
            "type": "object",
            "properties": {
                "references": {
                    "type": ["null", "string", "object"],
                    "default": null,
                    "description": "Optional local reference root or explicit role-to-path object.",
                    "oneOf": [
                        { "type": "null" },
                        { "type": "string", "format": "directory-path", "exists": true },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["root", "assets"],
                            "properties": {
                                "root": { "type": "string", "format": "directory-path", "exists": true },
                                "assets": {
                                    "type": "object",
                                    "minProperties": 1,
                                    "additionalProperties": { "type": "string", "format": "path" }
                                }
                            }
                        }
                    ]
                },
                "reference_mode": {
                    "type": "string",
                    "enum": ["auto", "local", "download"],
                    "default": "auto",
                    "description": "Resolve references from local files, downloads, or both in automatic mode."
                },
                "reference_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "references/dnaprs",
                    "description": "Persistent cache and output directory for verified reference assets."
                },
                "reference_bundle": {
                    "type": "string",
                    "default": "grch37-v1",
                    "description": "Pinned reference catalogue bundle identifier."
                },
                "reference_only": {
                    "type": "boolean",
                    "description": "Resolve and verify references without running participant analyses."
                },
                "beagle_jar": {
                    "type": ["string", "null"],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional local Beagle JAR overriding the catalogue asset."
                },
                "unbref3_jar": {
                    "type": ["string", "null"],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional local unbref3 JAR overriding the catalogue asset."
                }
            }
        },
        "analysis_options": {
            "title": "PRS analysis options",
            "type": "object",
            "properties": {
                "methods": {
                    "type": "string",
                    "enum": ["plink_ct", "sbayesrc", "plink_ct,sbayesrc"],
                    "default": "plink_ct,sbayesrc",
                    "description": "Comma-separated PRS methods to run."
                },
                "genome": {
                    "type": "string",
                    "enum": ["GRCh37"],
                    "default": "GRCh37",
                    "description": "Genome build required by the current reference bundle."
                },
                "seed": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 20260829,
                    "description": "Reproducible random seed used by stochastic analysis steps."
                },
                "sample_missingness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.02,
                    "description": "Maximum missing-call fraction allowed per participant."
                },
                "imputation_variant_missingness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.1,
                    "description": "Maximum variant missingness before the imputation checkpoint."
                },
                "direct_variant_missingness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.01,
                    "description": "Maximum variant missingness for direct-genotype sensitivity scoring."
                },
                "maf_filter": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.5,
                    "default": 0,
                    "description": "Optional minor-allele-frequency threshold for target QC."
                },
                "hwe_filter": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0,
                    "description": "Optional Hardy-Weinberg exact-test p-value threshold for target QC."
                },
                "ancestry_pcs": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20,
                    "default": 10,
                    "description": "Number of reference principal components used for ancestry distance."
                },
                "ancestry_percentile": {
                    "type": "number",
                    "exclusiveMinimum": 0.9,
                    "exclusiveMaximum": 1,
                    "default": 0.99,
                    "description": "Empirical European-reference distance percentile for the primary-analysis flag."
                },
                "target_imputation": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run chromosome-level Beagle imputation before primary scoring."
                },
                "imputation_dr2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.8,
                    "description": "Minimum Beagle dosage R-squared retained after imputation."
                },
                "report_enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Render the portable HTML report and downloadable report assets."
                },
                "stop_after": {
                    "type": "string",
                    "enum": ["target_qc", "imputation", "prs", "phenotype", "report"],
                    "default": "report",
                    "description": "Last scientific stage to execute."
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "properties": {
                "version": { "type": "boolean", "hidden": true, "description": "Print the pipeline version and exit." },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "hidden": true,
                    "description": "Nextflow publishDir transfer mode."
                },
                "email": {
                    "type": ["string", "null"],
                    "hidden": true,
                    "description": "Email address that receives the completion summary."
                },
                "email_on_fail": {
                    "type": ["string", "null"],
                    "hidden": true,
                    "description": "Email address notified only when execution fails."
                },
                "plaintext_email": {
                    "type": "boolean",
                    "hidden": true,
                    "description": "Send completion email as plain text."
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "hidden": true,
                    "description": "Disable coloured terminal log output."
                },
                "validate_params": {
                    "type": "boolean",
                    "default": true,
                    "hidden": true,
                    "description": "Validate supplied parameters against this schema."
                },
                "help": { "type": "boolean", "hidden": true, "description": "Print the concise parameter help text." },
                "help_full": {
                    "type": "boolean",
                    "hidden": true,
                    "description": "Print the complete parameter help text."
                },
                "show_hidden": {
                    "type": "boolean",
                    "hidden": true,
                    "description": "Include hidden generic parameters in help output."
                },
                "custom_config_version": {
                    "type": "string",
                    "default": "master",
                    "hidden": true,
                    "description": "Version of the optional nf-core institutional configuration."
                },
                "custom_config_base": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "hidden": true,
                    "description": "Base URL for optional nf-core institutional configurations."
                },
                "config_profile_name": {
                    "type": ["string", "null"],
                    "hidden": true,
                    "description": "Display name of an active institutional configuration."
                },
                "config_profile_description": {
                    "type": ["string", "null"],
                    "hidden": true,
                    "description": "Description of an active institutional configuration."
                },
                "config_profile_contact": {
                    "type": ["string", "null"],
                    "hidden": true,
                    "description": "Support contact for an active institutional configuration."
                },
                "config_profile_url": {
                    "type": ["string", "null"],
                    "hidden": true,
                    "description": "Documentation URL for an active institutional configuration."
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/phenotype_options" },
        { "$ref": "#/$defs/reference_options" },
        { "$ref": "#/$defs/analysis_options" },
        { "$ref": "#/$defs/generic_options" }
    ]
}
