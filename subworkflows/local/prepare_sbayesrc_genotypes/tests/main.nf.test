nextflow_workflow {
    name "Prepare SBayesRC genotypes once per cohort"
    script "../../../../tests/workflows/sbayesrc_genotypes.nf"
    workflow "TEST_SBAYESRC_REUSE"
    options "-stub-run"
    // Directory outputs are checked by cohort, without file-content sorting.
    autoSort false
    tag "sbayesrc"

    test("two cohorts reuse their own prepared genotypes across two traits") {
        when {
            workflow {
                """
                input[0] = file("${projectDir}/tests/data/sbayesrc/chr1.vcf")
                input[1] = file("${projectDir}/bin/prepare_sbayesrc_genotypes.R")
                input[2] = 1
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.prepared.size() == 2
            assert workflow.out.qc.size() == 2
            assert workflow.out.logs.size() == 2
            assert workflow.out.logs.collect { it[0] }.sort { it.cohort } == [
                [cohort: 'FIRST', scoring_stage: 'imputed'],
                [cohort: 'SECOND', scoring_stage: 'imputed']
            ]
            for (record in workflow.out.logs) {
                assert file(record[1]).name == "${record[0].cohort}_chr1.log"
                assert file(record[1]).size() > 0
            }
            assert workflow.out.traits.size() == 4
            assert workflow.out.traits.collect { "${it[0].cohort}:${it[5]}" }.sort() == ['FIRST:TRAIT1', 'FIRST:TRAIT2', 'SECOND:TRAIT1', 'SECOND:TRAIT2']
            for (record in workflow.out.prepared) {
                def cohort = record[0].cohort
                def rows = file("${record[1]}/${cohort}_chr1.pvar").text.readLines().findAll { !it.startsWith('#') }
                assert rows[0].split('\t')[2] == 'rs1'
                def samples = file("${record[1]}/${cohort}_chr1.psam").text.readLines().tail()
                assert samples.sort() == ["${cohort}_1\tTEST01".toString(), "${cohort}_2\tTEST02".toString()]
                assert file(record[4]).text.readLines() == ["${cohort}_2\tTEST02".toString(), "${cohort}_1\tTEST01".toString()]
                assert workflow.out.traits.findAll { it[0].cohort == cohort }.collect { it[1].toString() }.unique() == [record[1].toString()]
            }
        }
    }
}
