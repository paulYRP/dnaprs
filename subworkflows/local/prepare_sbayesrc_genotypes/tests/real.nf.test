nextflow_workflow {
    name "Real autosomal SBayesRC genotype preparation"
    script "../../../../tests/workflows/sbayesrc_genotypes.nf"
    workflow "TEST_SBAYESRC_REUSE"
    // Directory outputs are checked by cohort, without file-content sorting.
    autoSort false
    tag "sbayesrc"

    test("preserve rsIDs and original family IDs across two complete cohorts") {
        when {
            workflow {
                """
                input[0] = file("${projectDir}/tests/data/sbayesrc/chr1.vcf")
                input[1] = file("${projectDir}/bin/prepare_sbayesrc_genotypes.R")
                input[2] = 22
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.prepared.size() == 2
            assert workflow.out.logs.size() == 44
            assert workflow.out.logs.collect { it[0] }.unique().sort { it.cohort } == [
                [cohort: 'FIRST', scoring_stage: 'imputed'],
                [cohort: 'SECOND', scoring_stage: 'imputed']
            ]
            assert workflow.out.traits.size() == 4
            for (record in workflow.out.prepared) {
                def cohort = record[0].cohort
                def logs = workflow.out.logs.findAll { it[0].cohort == cohort }
                assert logs.collect { file(it[1]).name }.sort() == (1..22).collect { "${cohort}_chr${it}.log".toString() }.sort()
                assert logs.every { file(it[1]).size() > 0 }
                def summary = workflow.out.qc.find { it[0].cohort == cohort }
                def rows = file(summary[1]).text.readLines().tail().collect { it.split('\t') }
                assert rows.collect { it[1] as Integer } == (1..22).toList()
                assert rows.every { it[2..8] == ['2', '3', '2', '1', '0', 'TRUE', 'PASS'] }
                for (chromosome in 1..22) {
                    def prefix = "${record[1]}/${cohort}_chr${chromosome}"
                    def variants = file("${prefix}.pvar").text.readLines().findAll { !it.startsWith('#') }
                    assert variants.collect { it.split('\t')[2] } == ["rs${chromosome}_A".toString(), "rs${chromosome}_B".toString(), "${chromosome}:300:G:A".toString()]
                    def samples = file("${prefix}.psam").text.readLines().tail().collect { it.split('\t') }
                    assert samples.collect { it[0] } == ["${cohort}_1".toString(), "${cohort}_2".toString()]
                    assert samples.collect { it[1] } == ['TEST01', 'TEST02']
                    assert file("${prefix}.pgen").size() > 0
                }
                assert file(record[4]).text.readLines() == ["${cohort}_2\tTEST02".toString(), "${cohort}_1\tTEST01".toString()]
                assert workflow.out.traits.findAll { it[0].cohort == cohort }.collect { it[1] }.unique() == [record[1]]
            }
        }
    }
}
