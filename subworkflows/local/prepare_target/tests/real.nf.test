nextflow_workflow {

    name "Test PREPARE_TARGET source-marker selection with real software"
    script "../main.nf"
    workflow "PREPARE_TARGET"
    tag "modules"
    tag "modules_local"
    tag "modules_real"
    tag "prepare_target"

    test("retained source probe is extracted before rsID renaming - real") {

        when {
            workflow {
                """
                input[0] = [[cohort: 'COLLISION', role: 'target', format: 'ped', genotype: 'marker_collision.ped', sample: '', keep: '', dosage: 'DS', input_stage: 'raw', assay_manifest: 'marker_collision_manifest.csv', marker_map: '', build: 'GRCh37', ancestry: 'European'], [file("${projectDir}/tests/data/target/marker_collision.ped"), file("${projectDir}/tests/data/target/marker_collision.map"), file("${projectDir}/tests/data/target/marker_collision_manifest.csv")]]
                input[1] = [[reference_id: 'DBSNP_COLLISION', path: 'marker_collision'], file("${projectDir}/tests/data/marker_resolution/marker_collision")]
                input[2] = [[reference_id: 'FASTA_COLLISION', path: 'marker_collision.fasta'], [file("${projectDir}/tests/data/marker_resolution/marker_collision.fasta"), file("${projectDir}/tests/data/marker_resolution/marker_collision.fasta.fai")]]
                input[3] = file("${projectDir}/bin/import_target.sh")
                input[4] = file("${projectDir}/bin/target_adapter.pl")
                input[5] = file("${projectDir}/bin/resolve_target_markers.R")
                input[6] = file("${projectDir}/bin/resolve_target_markers.sh")
                input[7] = file("${projectDir}/bin/finalise_target.sh")
                """
            }
        }

        then {
            def prepared = workflow.out.prepared[0]
            def pvar = file("${prepared[1]}/COLLISION.pvar").text.readLines().find { !it.startsWith('#') }.split('\t', -1)
            def decisions = file(workflow.out.marker_decisions[0][1]).text.readLines()
            def decisionHeader = decisions[0].split('\t', -1)
            def decisionRows = decisions.tail().collect { line ->
                [decisionHeader, line.split('\t', -1)].transpose().collectEntries()
            }
            assertAll(
                { assert workflow.success },
                { assert pvar[2] == 'rs116820347' },
                { assert pvar[3..4] == ['G', 'A'] },
                { assert decisionRows.find { it.source_id == '1:53072432' }.decision.startsWith('RETAINED_') },
                { assert decisionRows.find { it.source_id == '1:53072432' }.call_count == '2' },
                { assert decisionRows.find { it.source_id == 'rs116820347' }.decision.startsWith('EXCLUDED_') },
                { assert decisionRows.find { it.source_id == 'rs116820347' }.call_count == '0' },
                { assert decisionRows.count { it.decision.startsWith('RETAINED_') } == 1 }
            )
        }
    }

    for (fixture in ['concordant', 'discordant']) {
        test("${fixture} repeated probes use restricted genotype export - real") {
            when {
                workflow {
                    """
                    input[0] = [[cohort: 'PROBES', role: 'target', format: 'ped', genotype: '${fixture}.ped', sample: '', keep: '', dosage: 'DS', input_stage: 'raw', assay_manifest: 'marker_collision_manifest.csv', marker_map: '', build: 'GRCh37', ancestry: 'European'], [file("${projectDir}/tests/data/marker_resolution/${fixture}.ped"), file("${projectDir}/tests/data/marker_resolution/${fixture}.map"), file("${projectDir}/tests/data/target/marker_collision_manifest.csv")]]
                    input[1] = [[reference_id: 'DBSNP', path: 'marker_collision'], file("${projectDir}/tests/data/marker_resolution/marker_collision")]
                    input[2] = [[reference_id: 'FASTA', path: 'marker_collision.fasta'], [file("${projectDir}/tests/data/marker_resolution/marker_collision.fasta"), file("${projectDir}/tests/data/marker_resolution/marker_collision.fasta.fai")]]
                    input[3] = file("${projectDir}/bin/import_target.sh")
                    input[4] = file("${projectDir}/bin/target_adapter.pl")
                    input[5] = file("${projectDir}/bin/resolve_target_markers.R")
                    input[6] = file("${projectDir}/bin/resolve_target_markers.sh")
                    input[7] = file("${projectDir}/bin/finalise_target.sh")
                    """
                }
            }
            then {
                if (fixture == 'concordant') {
                    assert workflow.success
                    assert file(workflow.out.duplicate_markers[0][1]).text.readLines() == ['1:53072432', 'rs116820347']
                    def lines = file(workflow.out.marker_decisions[0][1]).text.readLines()
                    def header = lines[0].split('\t')
                    def decisions = lines.tail().collect { line -> [header, line.split('\t', -1)].transpose().collectEntries() }
                    assert decisions.find { it.source_id == 'rs116820347' }.decision == 'RETAINED_DUPLICATE_REPRESENTATIVE'
                    assert decisions.find { it.source_id == '1:53072432' }.decision == 'EXCLUDED_REDUNDANT_DUPLICATE_PROBE'
                } else {
                    assert workflow.failed
                    assert workflow.errorReport.contains('Raw marker resolution retained no variants')
                }
            }
        }
    }
}
