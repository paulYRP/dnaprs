nextflow_pipeline {

    name "Run chromosome imputation with real Beagle and PLINK tools"
    script "../main.nf"
    config "./symlink.config"
    tag "pipeline"
    tag "real"
    tag "imputation"

    test("one synthetic chromosome passes real imputation QC") {

        when {
            params {
                outdir = "$outputDir"
                run_name = "imputation"
                methods = "plink_ct"
                target_imputation = true
                stop_after = "imputation"
                report_enabled = false
                beagle_jar = System.getenv("DNAPRS_TEST_BEAGLE_JAR")
                references = [
                    root: "${projectDir}/tests/data/reference",
                    assets: [
                        dbsnp: 'dbsnp_source',
                        fasta: 'human_g1k_v37.fasta',
                        fasta_index: 'human_g1k_v37.fasta.fai',
                        imputation_panel: 'real_imputation_panel',
                        genetic_maps: 'real_imputation_map',
                        population_metadata: 'population.tsv',
                        related_samples: 'related.txt',
                        unbref3_jar: 'unbref3.test.jar',
                    ],
                ]
            }
        }

        then {
            def runDir = "$outputDir/imputation"
            def qc = path("$runDir/data/target_imputation/TEST/TEST.imputation_qc.tsv")
            def manifest = path("$runDir/data/target_imputation/TEST/TEST.imputation_manifest.tsv")

            assert workflow.success
            def qcRows = qc.text.readLines().collect { it.split("\t") }
            def imputedColumn = qcRows.first().toList().indexOf("imputed_variants")
            assertAll(
                { assert qc.exists() },
                { assert qc.text.contains("sample_order\tunique_variant_keys\tdosage_range\treference_alleles\tstatus") },
                { assert qc.text.contains("PASS\tPASS\tPASS\tPASS\tPASS") },
                { assert imputedColumn >= 0 && qcRows.drop(1).every { it[imputedColumn].toInteger() > 0 } },
                { assert manifest.exists() },
                { assert manifest.text.contains("GRCh37\t0.80\tPASS") },
                { assert path("$runDir/data/checkpoints/imputed/TEST.imputed/TEST.pgen").exists() },
                { assert path("$runDir/data/pipeline_info/software_versions.yml").text.contains("TARGET_IMPUTE_CHROMOSOME") }
            )
        }
    }
}
