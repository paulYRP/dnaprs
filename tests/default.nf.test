nextflow_pipeline {

    name "Run the complete dnaprs graph in stub mode"
    script "../main.nf"
    tag "pipeline"

    test("complete PLINK and SBayesRC workflow") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def run_dir = "$outputDir/test_full"
            assert workflow.success
            assertAll(
                { assert path("$run_dir/run/preflight/target_manifest.validated.tsv").exists() },
                { assert path("$run_dir/gwas/MDD/MDD.cojo.ma").exists() },
                { assert path("$run_dir/plink_ct/MDD/MDD.plink_ct.weights.tsv").exists() },
                { assert path("$run_dir/sbayesrc/MDD/model/MDD.sbayesrc.txt").exists() },
                { assert path("$run_dir/scores/combined/prs_scores_long.tsv").exists() },
                { assert path("$run_dir/phenotype/phenotype_associations.tsv").exists() },
                { assert path("$run_dir/qc/generation/variant_flow.tsv").exists() },
                { assert path("$run_dir/reports/index.html").exists() },
                { assert path("$run_dir/run/published_files.json").exists() },
                { assert snapshot(
                    removeNextflowVersion("$run_dir/pipeline_info/software_versions.yml")
                ).match() }
            )
        }
    }
}
