nextflow_pipeline {

    name "Run the minimal dnaprs analysis with real tools"
    script "../main.nf"
    tag "pipeline"
    tag "real"

    test("raw VCF through PLINK C+T, Gaussian phenotype model, and report") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def runDir = "$outputDir/test"
            def plan = path("$runDir/data/inputs/run_plan.tsv")
            def prep = path("$runDir/data/target_prep/TEST/TEST.target_prep_summary.tsv")
            def coverage = path("$runDir/data/qc/scores/TEST/MDD/TEST.MDD.plink_ct.variant_coverage.tsv")
            def association = path("$runDir/data/phenotype/phenotype_associations.tsv")
            def report = path("$runDir/reports/index.html")
            def logsPage = path("$runDir/reports/logs.html")

            assert workflow.success
            assertAll(
                { assert plan.exists() },
                { assert plan.text.contains("run_prs\ttrue") },
                { assert prep.exists() },
                { assert prep.text.contains("TEST\traw") },
                { assert path("$runDir/data/inputs/checks/reference_integrity.tsv").exists() },
                { assert path("$runDir/data/target_prep/TEST/TEST.marker_decisions.tsv").exists() },
                { assert path("$runDir/data/target_qc/TEST/TEST.participant_decisions.tsv").exists() },
                { assert path("$runDir/data/gwas/MDD/MDD.cojo.ma").exists() },
                { assert path("$runDir/data/plink_ct/MDD/MDD.plink_ct.weights.tsv").exists() },
                { assert path("$runDir/data/scores/combined/prs_scores_long.tsv").exists() },
                { assert coverage.exists() },
                { assert coverage.text.contains("PASS") },
                { assert association.exists() },
                { assert association.text.contains("gaussian") },
                { assert report.exists() },
                { assert report.text.contains('aria-label="Open the dnaprs GitHub repository"') },
                { assert !report.text.contains('target="_blank"') },
                { assert !report.text.contains("figure-tabs") },
                { assert logsPage.exists() },
                { assert logsPage.text.contains("<details") },
                { assert logsPage.text.contains("Task trace") },
                { assert logsPage.text.contains("Report software") },
                { assert !logsPage.text.contains('target="_blank"') },
                { assert path("$runDir/reports/provenance/execution_report.html").exists() },
                { assert path("$runDir/reports/provenance/execution_timeline.html").exists() },
                { assert path("$runDir/reports/provenance/pipeline_dag.html").exists() },
                { assert snapshot(path("$runDir/data/pipeline_info/software_versions.yml")).match() },
                { assert path("$runDir/data/inputs/published_files.json").exists() },
                { assert path(runDir).toFile().list().sort() == ['data', 'figures', 'logs', 'reports'] }
            )
        }
    }
}
