nextflow_pipeline {

    name "Validate the complete dnaprs graph with process stubs"
    script "../main.nf"
    options "-stub-run"
    tag "pipeline"
    tag "stub"

    test("complete PLINK, SBayesRC, imputation, phenotype, and report graph") {

        when {
            params {
                outdir = "$outputDir"
                run_name = "stub"
                methods = "plink_ct,sbayesrc"
                target_imputation = true
            }
        }

        then {
            def runDir = "$outputDir/stub"
            def models = path("$runDir/data/inputs/models.tsv")
            assert workflow.success
            assertAll(
                { assert path("$runDir/data/inputs/run_plan.tsv").exists() },
                { assert path("$runDir/data/inputs/checks/reference_integrity.tsv").exists() },
                { assert models.text.readLines().tail().size() == 4 },
                { assert ['mhc_total', 'who_total', 'brs_total', 'bdsst_total'].every { models.text.contains(it) } },
                { assert path("$runDir/data/target_imputation/TEST/TEST.imputation_manifest.tsv").exists() },
                { assert path("$runDir/data/plink_ct/TEST/MDD/MDD.plink_ct.weights.tsv").exists() },
                { assert path("$runDir/data/sbayesrc/MDD/model/MDD.sbayesrc.txt").exists() },
                { assert path("$runDir/data/sbayesrc/genotypes/TEST/TEST.sbayesrc_genotypes/TEST_chr1.pvar").text.contains('rs1') },
                { assert path("$runDir/data/qc/sbayesrc/genotypes/TEST/TEST.sbayesrc.genotype_qc.tsv").exists() },
                { assert path("$runDir/data/qc/sbayesrc/MDD/TEST/TEST.MDD.sbayesrc.match_qc.tsv").exists() },
                { assert path("$runDir/data/checkpoints/imputed/TEST.imputed/TEST_chr1.pvar").text.contains('1:100:A:G') },
                { assert path("$runDir/data/scores/combined/prs_scores_long.tsv").exists() },
                { assert path("$runDir/data/phenotype/phenotype_associations.tsv").exists() },
                { assert path("$runDir/reports/index.html").exists() },
                { assert path("$runDir/figures").exists() },
                { assert snapshot(path("$runDir/data/pipeline_info/software_versions.yml")).match() },
                { assert path("$runDir/data/inputs/published_files.json").exists() },
                { assert path("$runDir/data/inputs/published_files.json").text.contains('TEST.sbayesrc_genotypes') },
                { assert !path("$runDir/reports/provenance/output_files.tsv").text.contains('TEST.sbayesrc_genotypes') },
                { assert path("$runDir/reports/provenance/output_files.tsv").text.contains('phenoPRS.csv') },
                { assert !path("$runDir/reports/downloads/sbayesrc/genotypes").exists() },
                { assert path(runDir).toFile().list().sort() == ['data', 'figures', 'logs', 'reports'] }
            )
        }
    }

    test("prepared SBayesRC genotypes are published when reporting is disabled") {

        when {
            params {
                outdir = "$outputDir"
                run_name = "without_report"
                methods = "plink_ct,sbayesrc"
                target_imputation = true
                report_enabled = false
            }
        }

        then {
            def runDir = "$outputDir/without_report"
            assert workflow.success
            assertAll(
                { assert path("$runDir/data/sbayesrc/genotypes/TEST/TEST.sbayesrc_genotypes/TEST_chr1.pvar").text.contains('rs1') },
                { assert path("$runDir/data/phenotype/phenoPRS.csv").exists() },
                { assert path("$runDir/data/inputs/published_files.json").text.contains('TEST.sbayesrc_genotypes') },
                { assert !path("$runDir/reports/index.html").exists() },
                { assert workflow.trace.tasks().every { !it.name.contains('RENDER_REPORT') } }
            )
        }
    }
}
